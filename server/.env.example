NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/allied-axis
JWT_SECRET=change-me
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRE=30d
# Hostinger — hPanel → Emails → alliedaxis.digital → Configure mail client
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@alliedaxis.digital
SMTP_PASS=your-hostinger-email-password
FROM_EMAIL=info@alliedaxis.digital
FROM_NAME=Allied Axis
CONTACT_NOTIFY_EMAIL=info@alliedaxis.digital
# Optional: Resend on Render (recommended for production API)
# RESEND_API_KEY=re_...
# RESEND_FROM=Allied Axis <info@alliedaxis.digital>
CLIENT_URL=http://localhost:3000
# Used in thank-you auto-reply links (production: https://alliedaxis.digital)
# Minimum seconds before a form can be submitted (anti-bot; default 3)
# FORM_MIN_SECONDS=3
# Comma-separated extra origins (e.g. Vercel production + previews you list explicitly)
# ALLOWED_ORIGINS=https://allied-axis.vercel.app,http://localhost:3000
# Allow any *.vercel.app preview URL (recommended when frontend is on Vercel)
ALLOW_VERCEL_PREVIEWS=true
# Set to false when API runs on Render and frontend on Vercel (default for split deploy)
SERVE_CLIENT=false
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
